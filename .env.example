# Copy to .env for local Docker Compose use. Do not commit credentials or service-account keys.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_AI_ENABLED=true
GEMINI_MODEL=gemini-2.0-flash-001

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=data_generation
POSTGRES_USER=data_generation
POSTGRES_PASSWORD=change-me-before-sharing

# Optional host port for Streamlit Docker Compose access (defaults to 8501).
APP_PORT=8501

# Optional observability. Leave blank to disable Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Keep false in shared/local demo environments. When true, telemetry may include prompt content.
OBSERVABILITY_CAPTURE_CONTENT=false

# Test-only: enables deterministic structured-output doubles for the browser E2E suite.
# Never enable this for a normal application run.
DETERMINISTIC_TEST_MODE=false
